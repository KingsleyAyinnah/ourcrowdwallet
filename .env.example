# ==============================================================================
# OURCR ONLINE - Environment Configuration Template
# Copy this file to .env and adjust variables for your live cPanel or local server.
# ==============================================================================

# Application Environment: 'development' | 'production'
# On production (cPanel), set to 'production' to disable all error popups and debug tools.
APP_ENV=production

# Application Debug Mode: 'true' | 'false' (Set to 'false' in production)
APP_DEBUG=false

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
